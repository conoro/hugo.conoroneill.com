#!/usr/bin/env bash
set -euo pipefail
project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$project_dir"
build_dir="$(mktemp -d -t hugo-production.XXXXXX)"
trap 'rm -rf -- "$build_dir"' EXIT
./scripts/hugo --environment production --baseURL https://conoroneill.com/ --destination "$build_dir" --panicOnWarning
python3 scripts/check_publication.py "$build_dir"
rsync -a --delete --exclude=CNAME --exclude=.nojekyll "$build_dir/" docs/
python3 scripts/check_publication.py docs
